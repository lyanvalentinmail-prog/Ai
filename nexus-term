#!/usr/bin/env python3
"""
Lanzador directo de NEXUS-TERM (Terminal/Shell Propia Híbrida: Comandos + IA en pantalla separada).
"""

import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from ia_core.cli import main

if __name__ == "__main__":
    args = sys.argv[1:] if len(sys.argv) > 1 else ["terminal"]
    raise SystemExit(main(args))
