#!/usr/bin/env python3
"""
Ejecutable principal de NEXUS — Inteligencia Artificial Propia para Termux y Linux.
Puede invocarse directamente (`./ia`) o mediante enlace simbólico global (`$PREFIX/bin/ia`).
"""

import sys
from pathlib import Path

# Resolver la ruta real incluso cuando se ejecuta vía symlink desde $PREFIX/bin/ia en Termux
REPO_ROOT = Path(__file__).resolve().parent
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from ia_core.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
